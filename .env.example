# Neon Postgres (pooler — для приложения)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"
# Прямое подключение — для prisma migrate / db push
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
NEON_BRANCH="production"

# Neon Data API (PostgREST) — https://….apirest….neon.tech/neondb/rest/v1
NEON_DATA_API_URL="https://ep-xxxx.apirest.c-7.us-east-2.aws.neon.tech/neondb/rest/v1"

# Neon Auth (JWT for Data API)
NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth"
NEON_AUTH_JWKS_URL="https://ep-xxxx.neonauth.c-7.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"

# Auth (AutoZap CRM — NextAuth). Не меняйте AUTH_SECRET между деплоями!
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-long-random-secret"
AUTH_SECRET="replace-with-long-random-secret"
AUTH_TRUST_HOST="true"

# Vercel Cron (опционально; на Vercel подставляется автоматически)
CRON_SECRET="replace-with-random-cron-secret"
